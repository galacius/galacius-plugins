{
  "name": "galacius-plugins",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "26"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build:helm": "bash plugins/helm/scripts/build.sh",
    "build:helm:fe": "pnpm --filter @galacius/helm-plugin-frontend run build",
    "build:helm:local": "pnpm build:helm:fe && node ./plugins/helm/scripts/deploy-plugin-helm-local.mjs",
    "build:resources-monitor": "bash plugins/resources-monitor/scripts/build.sh",
    "build:resources-monitor:fe": "pnpm --filter @galacius/resources-monitor-plugin-frontend run build",
    "build:resources-monitor:local": "pnpm build:resources-monitor:fe && node ./plugins/resources-monitor/scripts/deploy-plugin-resources-monitor-local.mjs",
    "build:local": "pnpm build:helm:local && pnpm build:resources-monitor:local",
    "test:helm:fe": "pnpm --filter @galacius/helm-plugin-frontend run test",
    "test:helm:fe:coverage": "pnpm --filter @galacius/helm-plugin-frontend run test:coverage",
    "test:helm:be": "cd plugins/helm && go test -race -v ./...",
    "test:helm:be:coverage": "cd plugins/helm && go test -race -v -cover -coverprofile=coverage.out ./...",
    "test:resources-monitor:fe": "pnpm --filter @galacius/resources-monitor-plugin-frontend run test",
    "test:resources-monitor:fe:coverage": "pnpm --filter @galacius/resources-monitor-plugin-frontend run test:coverage",
    "test:resources-monitor:be": "cd plugins/resources-monitor && go test -race -v ./...",
    "test:resources-monitor:be:coverage": "cd plugins/resources-monitor && go test -race -v -cover -coverprofile=coverage.out ./...",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md,yml}\"",
    "lint:fe": "eslint plugins/helm/frontend/src plugins/resources-monitor/frontend/src",
    "lint:be": "go vet -C plugins/helm ./... && go tool -C plugins/helm staticcheck ./... && go vet -C plugins/resources-monitor ./... && go tool -C plugins/resources-monitor staticcheck ./...",
    "prepare": "husky",
    "upgrade:all:fe": "ncu -u -t minor --dep prod,dev,optional --workspaces --root && pnpm install",
    "upgrade:all:helm:be": "go get -C plugins/helm -u -t ./... && go mod tidy -C plugins/helm",
    "upgrade:all:resources-monitor:be": "go get -C plugins/resources-monitor -u -t ./... && go mod tidy -C plugins/resources-monitor",
    "upgrade:all": "pnpm upgrade:all:fe && pnpm upgrade:all:helm:be && pnpm upgrade:all:resources-monitor:be"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "npm-check-updates": "^23.1.0",
    "prettier": "^3.9.7",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "^8.70.0"
  }
}
